{
  "name": "@search-tour/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:viewer": "vite --mode viewer --port 5174",
    "build": "tsc -b && vite build",
    "build:viewer": "tsc -b && vite build --mode viewer",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  }
}
